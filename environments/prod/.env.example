# YouTube Manager MCP Server: VPS Production Environment
# Copy this file to /app/data/youtube-manager/.env and fill in the values.

PORT=8080
BASE_URL=https://ytm.mcp.scm-platform.org

# HashiCorp Vault (primary credential source on VPS)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/credentials/google-credentials

# Cookie file path (local file on VPS)
COOKIES_FILE=/app/data/youtube-manager/cookies.txt
